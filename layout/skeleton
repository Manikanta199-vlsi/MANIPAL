; --- open or create a layout cellview ---
(procedure (open_layout_cv lib cell)
  (dbOpenCellViewByType lib cell "layout" "maskLayout" t)
)

; --- create a sample inverter ---
(procedure (demo_inv libName)
  (let (cv)
    (setq cv (open_layout_cv libName "INV_DEMO"))
    ; The lines below show how to place one transistor.
    ; You will fill in your own coordinates and parameters in the lab.
    (printf "Use Add→Instance in Virtuoso to place NMOS/PMOS here.\n")
    (printf "Then come back and translate that placement into SKILL calls.\n")
    (dbSave cv)
  )
)

